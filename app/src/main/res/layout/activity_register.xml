<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#080C12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/hashbox_logo"
            android:contentDescription="@string/logo"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/secure_registration"
            android:textColor="#64B5F6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_your_space"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <EditText
            android:id="@+id/etRegEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:autofillHints="emailAddress"
            android:hint="@string/email_address"
            android:textColor="#FFFFFF"
            android:textColorHint="#607D9A"
            android:inputType="textEmailAddress"
            android:padding="16dp"
            android:background="#111923"
            android:layout_marginBottom="14dp"/>

        <EditText
            android:id="@+id/etRegPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:autofillHints="password"
            android:hint="@string/password_hint_min_6"
            android:textColor="#FFFFFF"
            android:textColorHint="#607D9A"
            android:inputType="textPassword"
            android:padding="16dp"
            android:background="#111923"
            android:layout_marginBottom="24dp"/>

        <!-- Working Button 3: Register -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:backgroundTint="#1976D2"
            android:text="@string/sign_up"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <!-- Working Button 4: Back to Login -->
        <Button
            android:id="@+id/btnBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#151D27"
            android:text="@string/back_to_login"
            android:textColor="#64B5F6"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
